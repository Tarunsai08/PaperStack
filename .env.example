# Copy to .env for local pipeline runs. Never commit real keys.

# Free tier from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier from https://console.groq.com/keys
GROQ_API_KEY=
# Optional, raises Semantic Scholar rate limits: https://www.semanticscholar.org/product/api
S2_API_KEY=

# App build (set automatically in CI)
VITE_CONTENT_BASE_URL=https://<owner>.github.io/<repo>/content
VITE_GITHUB_REPO=<owner>/<repo>
VITE_APP_VERSION=1.0.0-dev
